{
	"name": "pi-honcho",
	"version": "0.1.8",
	"description": "Durable, privacy-aware memory for Pi, powered by Honcho.",
	"type": "module",
	"author": "Giuseppe Rodriguez",
	"license": "MIT",
	"keywords": [
		"pi",
		"pi-package",
		"honcho",
		"memory",
		"ai",
		"coding-agent"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/giuseppecrj/pi-honcho.git"
	},
	"homepage": "https://github.com/giuseppecrj/pi-honcho#readme",
	"bugs": {
		"url": "https://github.com/giuseppecrj/pi-honcho/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src/**/*.ts",
		"!src/**/*.test.ts",
		"README.md",
		"LICENSE",
		"THIRD_PARTY_NOTICES.md"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		],
		"image": "https://raw.githubusercontent.com/giuseppecrj/pi-honcho/v0.1.2/docs/assets/pi-honcho-gallery.png"
	},
	"scripts": {
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check .",
		"test": "tsx --test src/**/*.test.ts test/**/*.test.ts",
		"typecheck": "tsc --noEmit",
		"verify": "npm run typecheck && npm run lint && npm test",
		"changelog": "auto-changelog --package",
		"version": "npm run changelog && git add CHANGELOG.md"
	},
	"dependencies": {
		"@honcho-ai/sdk": "2.2.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.0",
		"@earendil-works/pi-coding-agent": "^0.84.1",
		"@types/node": "^26.1.1",
		"auto-changelog": "2.6.0",
		"tsx": "^4.23.0",
		"typebox": "1.3.7",
		"typescript": "^7.0.2"
	}
}
